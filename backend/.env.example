# Template for backend/.env. Copy it once (PowerShell, inside the backend folder):
#   Copy-Item .env.example .env
# then replace SESSION_SECRET with a long random value. This prints one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Port and network interface the API listens on.
# 127.0.0.1 means only this computer can reach the API, not others on the same Wi-Fi.
# If you change PORT, change the proxy target in frontend/vite.config.js too.
PORT=5000
HOST=127.0.0.1

# Local MongoDB Community Server. Use 127.0.0.1 rather than "localhost": on Windows,
# Node can resolve "localhost" to the IPv6 address ::1, where MongoDB is not listening.
MONGODB_URI=mongodb://127.0.0.1:27017/naac_evidence_repo

# Signs the session cookie so it cannot be forged. Every machine should use its own value.
SESSION_SECRET=replace-with-a-long-random-string

# FR-007: users are logged out after this many minutes without any activity.
# Set it to 1 during the viva to demonstrate the timeout quickly.
SESSION_IDLE_MINUTES=30

# Address of the React dev server. CORS only accepts browser requests from this origin.
CLIENT_ORIGIN=http://localhost:5173

# development or production
NODE_ENV=development
